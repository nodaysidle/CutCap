#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="${BUILD_DIR:-$ROOT/build}"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

qmake6 "$ROOT/cutcap.pro"
make -j"$(nproc)"

# The module's type info is what qmllint reads; keep the committed copy in step with the build.
if [ -f "$BUILD_DIR/cutcap.qmltypes" ]; then
    cp -f "$BUILD_DIR/cutcap.qmltypes" "$ROOT/cutcap.qmltypes"
fi

echo "Built $BUILD_DIR/cutcap"
